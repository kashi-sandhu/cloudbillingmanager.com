# Cloud Billing Manager — Apache (cPanel) SPA + SEO HTML shells
# Route folders (e.g. /demo/index.html) are served first so View Source has page SEO.
# Unknown routes fall back to the React SPA shell.
#
# Cloudflare may add a trailing slash. React strips it client-side.
# DirectorySlash must stay Off so /about serves about/index.html without a 301 loop.

DirectoryIndex index.html
DirectorySlash Off
Options -Indexes

# SPA soft-404 — never return a bare Apache 404 for unknown paths (hurts Google)
ErrorDocument 404 /index.html

<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# Force static SEO files (fixes .xml 500 on some cPanel hosts)
<FilesMatch "^(sitemap-index\.xml|sitemap\.xml|sitemap-pages\.xml|sitemap-core\.xml|sitemap-platform\.xml|sitemap-industries\.xml|sitemap-blog\.xml|sitemap-resources\.xml|sitemap-pages\.txt|sitemap\.php|sitemap-pages\.php|robots\.txt|llms\.txt|brand\.txt|urllist\.txt|google-search-console-indexing\.txt|google-index-pages\.txt|seo-manifest\.json|manifest\.webmanifest|DEPLOY-SEO-NOW\.txt)$">
  SetHandler default-handler
  RemoveHandler .xml
</FilesMatch>

<Files "sitemap-pages.txt">
  ForceType application/xml
</Files>

<Files "sitemap.xml">
  ForceType application/xml
</Files>
<Files "sitemap-pages.xml">
  ForceType application/xml
</Files>
<Files "sitemap-index.xml">
  ForceType application/xml
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: https://cloudbillingmanager.com (non-www, HTTPS)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

  RewriteCond %{HTTP_HOST} ^www\.cloudbillingmanager\.com$ [NC]
  RewriteRule ^ https://cloudbillingmanager.com%{REQUEST_URI} [L,R=301,NE]

  # Old Resources hub → Pricing (keep child /resources/* guides)
  RewriteRule ^resources/?$ /pricing [R=301,L]

  # Legacy WordPress / old-site URLs → new SPA paths (fixes GSC 404s)
  RewriteRule ^privacy-policy/?$ /privacy [R=301,L,NC]
  RewriteRule ^about-us/?$ /about [R=301,L,NC]
  RewriteRule ^contact-us/?$ /contact [R=301,L,NC]
  RewriteRule ^create-ticket/?$ /contact [R=301,L,NC]
  RewriteRule ^terms-of-service/?$ /terms [R=301,L,NC]
  RewriteRule ^terms-and-conditions/?$ /terms [R=301,L,NC]
  RewriteRule ^features/purchase-receipts/?$ /platform/purchasing [R=301,L,NC]
  RewriteRule ^features/?$ /platform [R=301,L,NC]
  RewriteRule ^10-top-tips-for-making-your-saas-product-sticky/?$ /blog [R=301,L,NC]

  # Common typos / truncated URLs (WhatsApp / GSC copies)
  RewriteRule ^blog/category/business-managemen/?$ /blog/category/business-management [R=301,L,NC]
  RewriteRule ^blog/category/sales-purchase/?$ /blog/category/sales-purchases [R=301,L,NC]
  RewriteRule ^images/og/cloudbillingmanager-og\.jp$ /images/og/cloudbillingmanager-og.jpg [R=301,L,NC]
  RewriteRule ^banners/customers\.web$ /banners/customers.webp [R=301,L,NC]

  # Static SEO / verification files — must exist in public_html (upload from dist/)
  RewriteRule ^sitemap/ - [L,NC]
  RewriteRule ^robots\.txt$ - [L,NC]
  RewriteRule ^sitemap-index\.xml$ - [L,NC]
  RewriteRule ^sitemap-pages\.txt$ - [L,NC]
  RewriteRule ^sitemap\.xml$ - [L,NC]
  RewriteRule ^sitemap-pages\.xml$ - [L,NC]
  RewriteRule ^sitemap-core\.xml$ - [L,NC]
  RewriteRule ^sitemap-platform\.xml$ - [L,NC]
  RewriteRule ^sitemap-industries\.xml$ - [L,NC]
  RewriteRule ^sitemap-blog\.xml$ - [L,NC]
  RewriteRule ^sitemap-resources\.xml$ - [L,NC]
  RewriteRule ^sitemap-pages\.php$ - [L,NC]
  RewriteRule ^sitemap\.php$ - [L,NC]
  RewriteRule ^DEPLOY-SEO-NOW\.txt$ - [L,NC]
  RewriteRule ^llms\.txt$ - [L,NC]
  RewriteRule ^brand\.txt$ - [L,NC]
  RewriteRule ^urllist\.txt$ - [L,NC]
  RewriteRule ^google-index-pages\.txt$ - [L,NC]
  RewriteRule ^seo-manifest\.json$ - [L,NC]
  RewriteRule ^google-search-console-indexing\.txt$ - [L,NC]
  RewriteRule ^seo-sources\.txt$ - [L,NC]
  RewriteRule ^manifest\.webmanifest$ - [L,NC]

  # Google Search Console HTML-file verification (e.g. google123abc.html)
  RewriteRule ^google[a-z0-9]+\.html$ - [L,NC]

  # Dedicated 404 page (noindex — see dist/404.html)
  RewriteRule ^404\.html$ - [L,NC]

  # Serve prerendered route folders without requiring a trailing slash
  # /about  ->  /about/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Existing files (assets, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # SPA fallback for client-only / unknown routes (never hard-404)
  RewriteRule ^ index.html [L]
</IfModule>

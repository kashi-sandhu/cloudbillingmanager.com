# /resources/ — child guides stay; hub redirects to Pricing
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /resources/

  # Old Resources hub → Pricing
  RewriteRule ^$ /pricing [R=301,L]
  RewriteRule ^index\.html$ /pricing [R=301,L]

  # /resources/guide  →  /resources/guide/index.html  (no directory listing)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

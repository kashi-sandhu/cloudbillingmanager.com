# Cloud Billing Manager — environment template
# Copy to .env.local (local) or set in hosting. Do not commit real secrets if policy forbids it.

# Google Analytics 4 Measurement ID (optional). Leave empty to disable analytics scripts.
VITE_GA_MEASUREMENT_ID=

# Optional Google Search Console HTML-tag verification token (content value only).
# Prefer Domain property DNS TXT verification when possible.
# See public/google-search-console-indexing.txt for the full setup steps.
VITE_GSC_VERIFICATION=

# Optional Bing Webmaster Tools HTML-tag verification token (msvalidate.01 content value only).
VITE_BING_VERIFICATION=
